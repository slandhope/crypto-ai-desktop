# Local secrets (do not commit). Copy lines you need into `.env`.

# WalletConnect / Reown — free project id: https://cloud.reown.com
WALLETCONNECT_PROJECT_ID=

# Telegram API id/hash (optional)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Bot for DMs + group admin (kick/ban/mute/pin/title/joins)
# TELEGRAM_BOT_TOKEN=


# Optional: Moralis for wallet track / grade
# MORALIS_API_KEY=
