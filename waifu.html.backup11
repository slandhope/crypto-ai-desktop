<!DOCTYPE html>
<html>
<head>
<link rel="stylesheet" href="asuka-design.css">
  <meta charset="UTF-8">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:transparent !important; overflow:hidden; }
    canvas { display:block; background:transparent !important; position:fixed; bottom:0; right:0; }

    .btn {
      position:fixed; width:36px; height:36px; border-radius:50%;
      display:flex; align-items:center; justify-content:center;
      cursor:pointer; font-size:15px; z-index:100;
      transition:all 0.2s; backdrop-filter:blur(8px);
    }
    .btn:hover { transform:scale(1.12); }

    #history-btn   { bottom:580px; left:10px; background:rgba(255,200,0,0.15);  border:1px solid rgba(255,200,0,0.3); }
    #chat-btn      { bottom:530px; left:10px; background:rgba(0,212,255,0.15);  border:1px solid rgba(0,212,255,0.3); }
    #her-mute-btn  { bottom:480px; left:10px; background:rgba(52,211,153,0.15); border:1px solid rgba(52,211,153,0.3); }
    #mic-mute-btn  { bottom:430px; left:10px; background:rgba(251,191,36,0.15); border:1px solid rgba(251,191,36,0.3); }
    #webcam-btn    { bottom:380px; left:10px; background:rgba(255,140,0,0.15);  border:1px solid rgba(255,140,0,0.3); }
    #dashboard-btn { bottom:330px; left:10px; background:rgba(150,0,255,0.15);  border:1px solid rgba(150,0,255,0.3); }
    #care-btn { bottom:385px; left:10px; background:rgba(240,168,208,0.18); border:1px solid rgba(240,168,208,0.4); }

    #her-mute-btn.muted { background:rgba(248,113,113,0.2); border-color:rgba(248,113,113,0.4); }
    #mic-mute-btn.muted { background:rgba(248,113,113,0.2); border-color:rgba(248,113,113,0.4); }
    #webcam-btn.active  { background:rgba(52,211,153,0.2);  border-color:rgba(52,211,153,0.4); }

    #chat-panel {
      position:fixed; bottom:530px; left:54px; width:260px;
      background:rgba(4,7,26,0.96); border:1px solid rgba(0,212,255,0.2);
      padding:10px; display:none; flex-direction:column; gap:8px;
      z-index:100; border-radius:10px; backdrop-filter:blur(20px);
      box-shadow:0 8px 32px rgba(0,0,0,0.4);
    }
    #chat-panel.open { display:flex; }
    #input-row { display:flex; gap:6px; }
    #user-input {
      flex:1; background:rgba(0,212,255,0.06);
      border:1px solid rgba(0,212,255,0.2); border-radius:6px;
      color:#e0f4ff; font-family:-apple-system,sans-serif; font-size:12px;
      padding:7px 10px; outline:none; transition:border 0.2s;
    }
    #user-input:focus { border-color:rgba(0,212,255,0.5); }
    #user-input::placeholder { color:rgba(255,255,255,0.2); }
    #send-btn {
      padding:7px 12px; background:rgba(0,212,255,0.15);
      border:1px solid rgba(0,212,255,0.3); border-radius:6px;
      color:#00d4ff; font-size:11px; font-weight:600; cursor:pointer;
    }
    #send-btn:hover { background:rgba(0,212,255,0.3); }

    /* History panel */
    #history-panel {
      position:fixed; bottom:580px; left:54px; width:280px; max-height:340px;
      background:rgba(4,7,26,0.97); border:1px solid rgba(255,200,0,0.2);
      display:none; flex-direction:column; z-index:100; border-radius:10px;
      box-shadow:0 8px 32px rgba(0,0,0,0.4); backdrop-filter:blur(20px);
      overflow:hidden;
    }
    #history-panel.open { display:flex; }
    #history-header {
      padding:8px 12px; font-size:10px; font-weight:600; color:rgba(255,200,0,0.8);
      letter-spacing:1px; border-bottom:1px solid rgba(255,200,0,0.1);
      display:flex; justify-content:space-between; align-items:center; flex-shrink:0;
    }
    #history-clear { font-size:9px; color:rgba(248,113,113,0.7); cursor:pointer; padding:2px 6px; border:1px solid rgba(248,113,113,0.2); border-radius:4px; }
    #history-list { overflow-y:auto; flex:1; padding:8px; display:flex; flex-direction:column; gap:6px; }
    #history-list::-webkit-scrollbar { width:2px; }
    #history-list::-webkit-scrollbar-thumb { background:rgba(255,200,0,0.2); }
    .history-msg { padding:6px 10px; border-radius:8px; font-size:10px; line-height:1.4; max-width:100%; }
    .history-msg.user { background:rgba(0,212,255,0.1); border:1px solid rgba(0,212,255,0.15); color:#e0f4ff; align-self:flex-end; text-align:right; }
    .history-msg.asuka { background:rgba(255,200,0,0.08); border:1px solid rgba(255,200,0,0.12); color:rgba(255,230,150,0.9); align-self:flex-start; }
    .msg-label { font-size:8px; opacity:0.5; margin-bottom:2px; letter-spacing:0.5px; }

    /* Status bar */
    #status {
      position:fixed; bottom:10px; left:10px;
      color:#00d4ff; font-family:-apple-system,monospace; font-size:10px;
      background:rgba(0,0,0,0.7); padding:4px 10px; border-radius:20px;
      pointer-events:none; z-index:1000;
      border:1px solid rgba(0,212,255,0.15); backdrop-filter:blur(10px);
      max-width:300px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    }

    /* Gemini indicator */
    #gemini-indicator {
      position:fixed; bottom:36px; left:10px;
      font-size:9px; color:rgba(52,211,153,0.6);
      font-family:monospace; pointer-events:none; z-index:1000;
    }

    #drop-overlay {
      position:fixed; inset:0;
      background:rgba(0,212,255,0.06); border:2px dashed rgba(0,212,255,0.5);
      display:none; align-items:center; justify-content:center;
      color:#00d4ff; font-family:-apple-system,sans-serif; font-size:13px;
      z-index:200; pointer-events:none; border-radius:12px;
    }
    #drop-overlay.active { display:flex; }

    #confirm-bar {
      position:fixed; bottom:300px; left:54px; width:240px;
      background:rgba(4,7,26,0.96); border:1px solid rgba(0,212,255,0.2);
      padding:12px; display:none; flex-direction:column; gap:10px;
      z-index:100; border-radius:10px; backdrop-filter:blur(20px);
    }
    #confirm-bar.open { display:flex; }
    #confirm-text { color:#e0f4ff; font-size:11px; }
    #confirm-btns { display:flex; gap:8px; }
    .c-yes { flex:1; padding:6px; border-radius:6px; cursor:pointer; font-size:11px; font-weight:600; text-align:center; background:rgba(52,211,153,0.15); border:1px solid rgba(52,211,153,0.3); color:#34d399; }
    .c-no  { flex:1; padding:6px; border-radius:6px; cursor:pointer; font-size:11px; font-weight:600; text-align:center; background:rgba(248,113,113,0.1); border:1px solid rgba(248,113,113,0.2); color:#f87171; }

    video { display:none; }
  </style>
</head>
<body>
  <canvas id="canvas"></canvas>
  <div id="drop-overlay">Drop image or PDF 👁</div>
  <div id="status">Connecting...</div>
  <div id="gemini-indicator">● GEMINI LIVE</div>

  <div id="history-btn"  class="btn" title="Chat history">📜</div>
  <div id="chat-btn"     class="btn" title="Type message">💬</div>
  <div id="her-mute-btn" class="btn" title="Mute her voice">🔊</div>
  <div id="mic-mute-btn" class="btn" title="Mute your mic">🎤</div>
  <div id="webcam-btn"   class="btn" title="Toggle camera">📷</div>
  <div id="dashboard-btn" class="btn" title="Dashboard">📊</div>
  <div id="care-btn" class="btn" title="Care & Shop">🎀</div>

  <div id="levelup-pop" style="display:none;position:fixed;inset:0;z-index:10001;background:rgba(10,12,22,0.85);backdrop-filter:blur(8px);align-items:center;justify-content:center;flex-direction:column;font-family:system-ui;pointer-events:none;">
    <div style="text-align:center;animation:lupop .5s ease;">
      <div id="lu-emoji" style="font-size:72px;margin-bottom:10px;">💖</div>
      <div style="font-size:14px;color:#f0a8d0;font-weight:700;letter-spacing:2px;">RELATIONSHIP LEVEL UP</div>
      <div id="lu-tier" style="font-size:32px;font-weight:600;font-family:'Fraunces',serif;color:#fff;margin:6px 0;">Friend</div>
      <div id="lu-unlock" style="font-size:14px;color:#a78bfa;"></div>
    </div>
  </div>
  <style>@keyframes lupop{0%{transform:scale(.6);opacity:0}60%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}</style>

  <div id="care-panel" style="display:none;position:fixed;left:64px;bottom:20px;width:280px;z-index:9998;background:linear-gradient(180deg,rgba(22,27,46,0.98),rgba(15,19,32,0.98));border:1px solid rgba(167,139,250,0.3);border-radius:20px;padding:16px;box-shadow:0 12px 48px rgba(0,0,0,0.6);font-family:system-ui;color:#e8edf4;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
      <div style="font-size:15px;font-weight:600;font-family:'Fraunces',serif;">🎀 Care</div>
      <div style="font-size:12px;font-family:'JetBrains Mono',monospace;"><span id="care-coins">0</span> 🪙 · 🔥<span id="care-streak">0</span></div>
    </div>
    <div id="rel-box" style="background:rgba(240,168,208,0.1);border:1px solid rgba(240,168,208,0.25);border-radius:11px;padding:9px;margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:5px;">
        <span id="rel-tier">🌱 Acquaintance</span><span id="rel-next" style="color:#94a3b8;font-weight:500;"></span>
      </div>
      <div style="height:8px;background:#1e293b;border-radius:5px;overflow:hidden;"><div id="rel-fill" style="height:100%;width:0%;background:linear-gradient(90deg,#f0a8d0,#a78bfa);border-radius:5px;transition:.4s;"></div></div>
    </div>
    <div id="care-stats" style="font-size:11px;display:flex;flex-direction:column;gap:6px;margin-bottom:12px;"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:8px;">
      <button class="care-act" data-a="feed" style="padding:10px;border-radius:11px;border:1px solid #334155;background:#1e293b;color:#fff;cursor:pointer;font-size:13px;">🍰 Feed</button>
      <button class="care-act" data-a="pat" style="padding:10px;border-radius:11px;border:1px solid #334155;background:#1e293b;color:#fff;cursor:pointer;font-size:13px;">🤚 Pat</button>
      <button class="care-act" data-a="clean" style="padding:10px;border-radius:11px;border:1px solid #334155;background:#1e293b;color:#fff;cursor:pointer;font-size:13px;">🧼 Clean</button>
      <button class="care-act" data-a="play" style="padding:10px;border-radius:11px;border:1px solid #334155;background:#1e293b;color:#fff;cursor:pointer;font-size:13px;">🎀 Play</button>
    </div>
    <button id="shop-open-btn" style="width:100%;padding:11px;border-radius:11px;border:none;background:linear-gradient(135deg,#8b7cff,#c08bf0,#f3a8d0);color:#fff;cursor:pointer;font-weight:800;font-size:13px;">🛍️ Dress-Up Shop</button>
    <div id="care-close" style="text-align:center;margin-top:8px;font-size:11px;color:#64748b;cursor:pointer;">close</div>
  </div>

  <div id="quiz-box" style="display:none;position:fixed;right:12px;bottom:12px;width:min(42vw,420px);z-index:10000;background:rgba(13,20,32,0.97);border:2px solid #a78bfa;border-radius:16px;padding:14px;box-shadow:0 12px 48px rgba(0,0,0,0.6);font-family:system-ui;">
    <div id="quiz-q" style="font-size:14px;font-weight:600;color:#e2e8f0;margin-bottom:10px;line-height:1.4;"></div>
    <div id="quiz-options" style="display:flex;flex-direction:column;gap:6px;margin-bottom:8px;"></div>
    <div id="quiz-text-row" style="display:none;gap:6px;">
      <input id="quiz-text-input" placeholder="Type your answer..." style="flex:1;padding:9px;border-radius:8px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:13px;">
      <button id="quiz-text-send" style="background:#a78bfa;border:none;border-radius:8px;color:#fff;cursor:pointer;padding:0 14px;font-weight:600;">Send</button>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;">
      <span style="font-size:10px;color:#64748b;">🎤 or just say your answer</span>
      <span id="quiz-skip" style="font-size:11px;color:#64748b;cursor:pointer;">skip ✕</span>
    </div>
  </div>

  <video id="webcam-video" autoplay playsinline></video>
  <canvas id="webcam-canvas" style="display:none"></canvas>

  <div id="history-panel">
    <div id="history-header">
      <span>CHAT HISTORY</span>
      <div id="history-clear">CLEAR</div>
    </div>
    <div id="history-list"></div>
  </div>

  <div id="chat-panel">
    <div id="input-row">
      <input id="user-input" type="text" placeholder="Ask anything or paste CA..." />
      <div id="send-btn">Send</div>
    </div>
  </div>

  <div id="confirm-bar">
    <div id="confirm-text"></div>
    <div id="confirm-btns">
      <div class="c-yes" id="confirm-yes">Yes</div>
      <div class="c-no"  id="confirm-no">No</div>
    </div>
  </div>

  <script src="./assets/live2dcubismcore.min.js"></script>
  <script src="./node_modules/pixi.js/dist/browser/pixi.min.js"></script>
  <script src="./node_modules/pixi-live2d-display/dist/cubism4.min.js"></script>

  <script>
    const { ipcRenderer } = require('electron')
    const { Live2DModel } = PIXI.live2d

    // Terminal logger
    const log = (...args) => ipcRenderer.send('log', ...args)



    let activePipeline  = null
    let switchingPipeline = false

    // ── State ──────────────────────────────────────────────────────────────
    let model           = null
    let isHerMuted      = false
    let isMicMuted      = false
    let isProcessing    = false
    let botIsSpeaking   = false
    let webcamStream    = null
    let webcamActive    = false
    let awaitingConfirm = null
    let geminiWs        = null
    let geminiReady     = false
    let audioContext    = null
    let currentSource   = null
    let mediaStream     = null
    let audioProcessor  = null
    let sessionActive   = false
    let geminiRetryCount= 0
    const MAX_GEMINI_RETRIES = 999 // Always retry Gemini, never give up

    // Gemini session config
    const SAMPLE_RATE    = 16000
    const GEMINI_WS_URL  = 'wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent'

    const statusEl      = document.getElementById('status')
    const geminiIndEl   = document.getElementById('gemini-indicator')
    const dropOverlay   = document.getElementById('drop-overlay')
    const webcamVideo   = document.getElementById('webcam-video')
    const webcamCanvas  = document.getElementById('webcam-canvas')
    const webcamBtn     = document.getElementById('webcam-btn')
    const herMuteBtn    = document.getElementById('her-mute-btn')
    const micMuteBtn    = document.getElementById('mic-mute-btn')
    const chatBtn       = document.getElementById('chat-btn')
    const dashBtn       = document.getElementById('dashboard-btn')
    const chatPanel     = document.getElementById('chat-panel')
    const userInput     = document.getElementById('user-input')
    const sendBtn       = document.getElementById('send-btn')
    const confirmBar    = document.getElementById('confirm-bar')
    const confirmText   = document.getElementById('confirm-text')
    const confirmYes    = document.getElementById('confirm-yes')
    const confirmNo     = document.getElementById('confirm-no')
    const historyBtn    = document.getElementById('history-btn')
    const historyPanel  = document.getElementById('history-panel')
    const historyClear  = document.getElementById('history-clear')

    function setStatus(msg) { statusEl.textContent = msg }

    // ── Live2D ─────────────────────────────────────────────────────────────
    const pixiApp = new PIXI.Application({
      view: document.getElementById('canvas'),
      autoStart: true, transparent: true, backgroundAlpha: 0, width: 400, height: 700
    })
    async function loadModel() {
      try {
        model = await Live2DModel.from('./assets/model/huohuo.model3.json')
        pixiApp.stage.addChild(model)
        model.x = 280; model.y = 650; model.scale.set(0.07); model.anchor.set(0.5, 1)
        model.motion('idle')
      } catch(e) { setStatus('Model error: ' + e.message) }
    }
    loadModel()

    // Mouse tracking for Live2D
    document.addEventListener('mousemove', e => {
      if (!model) return
      const dx = (e.clientX / window.innerWidth - 0.5) * 2
      const dy = (e.clientY / window.innerHeight - 0.5) * 2
      try {
        model.internalModel.coreModel.setParameterValueById('ParamEyeBallX', dx * 1.2)
        model.internalModel.coreModel.setParameterValueById('ParamEyeBallY', -dy)
        model.internalModel.coreModel.setParameterValueById('ParamAngleX', dx * 18)
        model.internalModel.coreModel.setParameterValueById('ParamAngleY', -dy * 12)
      } catch(e) {}
    })

    // ── Drag window ────────────────────────────────────────────────────────
    let isDragging = false, dragX, dragY
    const noDragIds = ['history-btn','chat-btn','her-mute-btn','mic-mute-btn','user-input','send-btn','webcam-btn','dashboard-btn','care-btn','confirm-yes','confirm-no','history-clear']
    document.addEventListener('mousedown', e => {
      if (noDragIds.includes(e.target.id) || e.target.closest('#chat-panel') || e.target.closest('#confirm-bar') || e.target.closest('#history-panel')) return
      isDragging = true; dragX = e.screenX; dragY = e.screenY; e.preventDefault()
    })
    document.addEventListener('mousemove', e => {
      if (!isDragging) return
      ipcRenderer.send('move-waifu', { dx: e.screenX - dragX, dy: e.screenY - dragY })
      dragX = e.screenX; dragY = e.screenY
    })
    document.addEventListener('mouseup', () => isDragging = false)

    // ── Chat History ───────────────────────────────────────────────────────
    let chatHistory = []
    try { chatHistory = JSON.parse(localStorage.getItem('asukaHistory') || '[]') } catch(e) {}

    function addToHistory(role, text) {
      if (!text) return
      chatHistory.push({ role, text, time: new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }) })
      if (chatHistory.length > 100) chatHistory.shift()
      try { localStorage.setItem('asukaHistory', JSON.stringify(chatHistory)) } catch(e) {}
      if (historyPanel.classList.contains('open')) renderHistory()
    }

    function renderHistory() {
      const list = document.getElementById('history-list')
      list.innerHTML = chatHistory.slice(-30).map(m => `
        <div class="history-msg ${m.role}">
          <div class="msg-label">${m.role === 'user' ? 'YOU' : 'ASUKA'} · ${m.time}</div>
          ${m.text}
        </div>
      `).join('')
      list.scrollTop = list.scrollHeight
    }

    historyBtn.addEventListener('click', () => { historyPanel.classList.toggle('open'); if (historyPanel.classList.contains('open')) renderHistory() })
    historyClear.addEventListener('click', () => { chatHistory = []; try { localStorage.removeItem('asukaHistory') } catch(e) {}; renderHistory() })

    // ── ElevenLabs Streaming TTS ───────────────────────────────────────────
    let elevenLabsWs = null
    let ttsQueue     = []
    let ttsConnecting= false

    async function getElevenLabsKey() {
      const settings = await ipcRenderer.invoke('get-settings')
      return settings?.elevenLabsKey || null
    }

    async function speakText(text) {
      if (!text || isHerMuted) return
      // Use IPC to get audio from main process (ElevenLabs)
      const audio = await ipcRenderer.invoke('get-voice', text)
      if (audio) await playAudio(audio)
    }

    // Sentence splitter for streaming feel
    function splitIntoSentences(text) {
      return text.match(/[^.!?]+[.!?]+/g) || [text]
    }

    // ── Audio playback with lip sync ───────────────────────────────────────
    async function playAudio(b64) {
      if (!b64 || isHerMuted) return
      stopCurrentAudio()
      try {
        const bytes = new Uint8Array(atob(b64).split('').map(c => c.charCodeAt(0)))
        const blob  = new Blob([bytes], { type:'audio/mpeg' })
        const ctx   = new AudioContext()
        const buf   = await ctx.decodeAudioData(await blob.arrayBuffer())
        currentSource = ctx.createBufferSource()
        const an    = ctx.createAnalyser(); an.fftSize = 256
        currentSource.buffer = buf
        currentSource.connect(an); an.connect(ctx.destination)
        botIsSpeaking = true
        currentSource.start()
        const arr = new Uint8Array(an.frequencyBinCount)
        const tick = () => {
          if (!botIsSpeaking) return
          an.getByteFrequencyData(arr)
          const v = arr.reduce((a,b)=>a+b) / arr.length
          if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', Math.min(v/80,1)) } catch(e) {}
          requestAnimationFrame(tick)
        }
        tick()
        return new Promise(r => {
          currentSource.onended = () => {
            botIsSpeaking = false
            if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', 0) } catch(e) {}
            r()
          }
        })
      } catch(e) { botIsSpeaking = false }
    }

    function stopCurrentAudio() {
      botIsSpeaking = false
      try { if (currentSource) { currentSource.stop(); currentSource = null } } catch(e) {}
      if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', 0) } catch(e) {}
    }

    // ── Pipeline Switcher — hard stop all before switching ─────────────────
    async function stopAllPipelines() {
      geminiReady = false; sessionActive = false
      stopMicStreaming()
      stopNameDetection()
      if (geminiWs) { try { geminiWs.close(1000) } catch(e) {}; geminiWs = null }
      // Stop Grok in main.js
      ipcRenderer.invoke('grok-stop')
      ipcRenderer.removeAllListeners('grok-ready')
      ipcRenderer.removeAllListeners('grok-response')
      ipcRenderer.removeAllListeners('grok-speech-started')
      ipcRenderer.removeAllListeners('grok-error')
      ipcRenderer.removeAllListeners('grok-closed')
      stopCurrentAudio()
      await new Promise(r => setTimeout(r, 300))
    }

    async function switchToPipeline(pipeline) {
      if (switchingPipeline) return
      switchingPipeline = true
      await stopAllPipelines()
      activePipeline = pipeline
      switchingPipeline = false

      if (pipeline === 'gemini') {
        geminiIndEl.textContent = '● GEMINI LIVE'
        geminiIndEl.style.color = 'rgba(52,211,153,0.8)'
        connectGemini()
      } else if (pipeline === 'http') {
        geminiIndEl.textContent = '● HTTP'
        geminiIndEl.style.color = 'rgba(0,212,255,0.8)'
        startHTTPPipeline()
      }
      // Grok disabled — re-enable when needed
      // } else if (pipeline === 'grok') { connectGrok() }
    }

    // ── Tier 2: Grok Voice Agent (runs in main.js Node.js) ──────────────
    let grokMsgHistory = []
    let grokCurrentResponse = ''

    async function connectGrok() {
      if (activePipeline !== 'grok') return
      setStatus('Connecting to Grok...')
      geminiIndEl.textContent = '● GROK'
      geminiIndEl.style.color = 'rgba(100,200,255,0.8)'

      try {
        const result = await ipcRenderer.invoke('grok-start')
        if (!result?.success) {
          setStatus('Grok failed — switching to HTTP')
          switchToPipeline('http')
          return
        }

        // Listen for events from main.js Grok WebSocket
        ipcRenderer.removeAllListeners('grok-ready')
        ipcRenderer.removeAllListeners('grok-response')
        ipcRenderer.removeAllListeners('grok-speech-started')
        ipcRenderer.removeAllListeners('grok-error')
        ipcRenderer.removeAllListeners('grok-closed')

        ipcRenderer.on('grok-ready', () => {
          if (activePipeline !== 'grok') return
          console.log('Grok ready — starting mic')
          setStatus('Listening...')
          geminiIndEl.textContent = '● GROK'
          geminiIndEl.style.color = 'rgba(100,200,255,0.9)'
          startMicStreamingToGrok()
        })

        ipcRenderer.on('grok-speech-started', () => {
          if (activePipeline !== 'grok') return
          if (botIsSpeaking) stopCurrentAudio()
          setStatus('🎤 Hearing you...')
          // Fallback — if stuck hearing for 8 seconds, force response
          clearTimeout(window.grokSpeechTimeout)
          window.grokSpeechTimeout = setTimeout(() => {
            if (activePipeline === 'grok') {
              console.log('Grok speech timeout — forcing response')
              ipcRenderer.invoke('grok-force-response')
            }
          }, 8000)
        })

        ipcRenderer.on('grok-response', async (event, text) => {
          if (activePipeline !== 'grok' || !text) return
          console.log('Grok response received:', text.slice(0, 60))
          addToHistory('asuka', text)
          grokMsgHistory.push({ role: 'assistant', content: text })
          setStatus('"' + text.slice(0, 50) + '"')
          // Save session for handoff
          ipcRenderer.invoke('save-session', grokMsgHistory, { lastMessage: text })
          // Play via ElevenLabs — Asuka's exact voice
          if (!isHerMuted) {
            botIsSpeaking = true
            const audio = await ipcRenderer.invoke('get-voice', text)
            if (audio && activePipeline === 'grok') {
              await playAudio(audio)
            }
            botIsSpeaking = false
          }
          setStatus('Listening...')
        })

        ipcRenderer.on('grok-error', (event, err) => {
          console.error('Grok error:', err)
          if (activePipeline === 'grok') switchToPipeline('http')
        })

        ipcRenderer.on('grok-closed', (event, code) => {
          console.log('Grok closed with code:', code)
          stopMicStreaming()
          if (activePipeline === 'grok') {
            setStatus('Grok disconnected — switching to HTTP')
            switchToPipeline('http')
          }
        })

        ipcRenderer.on('grok-reconnecting', () => {
          if (activePipeline === 'grok') {
            setStatus('Grok reconnecting...')
            stopMicStreaming()
          }
        })

      } catch(e) {
        console.error('connectGrok error:', e)
        switchToPipeline('http')
      }
    }

    // Mic streaming to Grok — sends audio to main.js via IPC
    async function startMicStreamingToGrok() {
      if (activePipeline !== 'grok' || isMicMuted) return
      try { if (audioProcessor) { audioProcessor.disconnect(); audioProcessor = null } } catch(e) {}
      try { if (audioContext) { audioContext.close(); audioContext = null } } catch(e) {}
      try { if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null } } catch(e) {}

      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true }
        })
        audioContext = new AudioContext({ sampleRate: 24000 })
        const source = audioContext.createMediaStreamSource(mediaStream)
        audioProcessor = audioContext.createScriptProcessor(1024, 1, 1) // smaller buffer = less latency

        audioProcessor.onaudioprocess = (e) => {
          if (activePipeline !== 'grok' || isMicMuted) return
          const input = e.inputBuffer.getChannelData(0)
          // Convert to PCM16
          const pcm = new Int16Array(input.length)
          for (let i = 0; i < input.length; i++) {
            pcm[i] = Math.max(-32768, Math.min(32767, input[i] * 32767))
          }
          // Convert to base64 and send to main.js
          const b64 = btoa(String.fromCharCode(...new Uint8Array(pcm.buffer)))
          ipcRenderer.send('grok-audio-chunk', b64)
        }

        source.connect(audioProcessor)
        audioProcessor.connect(audioContext.destination)
        setStatus('Listening...')
      } catch(e) {
        console.error('Grok mic error:', e)
        switchToPipeline('http')
      }
    }

    async function stopGrokAudio() {} // placeholder

    // ── Utilities ──────────────────────────────────────────────────────────
    function blobToBase64(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.onloadend = () => resolve(reader.result.split(',')[1])
        reader.onerror = reject
        reader.readAsDataURL(blob)
      })
    }

    // ── Tier 3: HTTP Pipeline ─────────────────────────────────────────────
    let httpRecording    = false
    let httpChunks       = []
    let httpMediaRecorder= null

    function startHTTPPipeline() {
      if (activePipeline !== 'http') return
      setStatus('Listening...')
      startHTTPRecording()
    }

    async function startHTTPRecording() {
      if (activePipeline !== 'http' || isMicMuted || isProcessing || httpRecording) return
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true }
        })
        httpChunks = []
        httpMediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' })
        httpMediaRecorder.ondataavailable = e => { if (e.data.size > 0) httpChunks.push(e.data) }
        httpMediaRecorder.onstop = async () => {
          stream.getTracks().forEach(t => t.stop())
          httpRecording = false
          const blob = new Blob(httpChunks, { type: 'audio/webm' })
          if (blob.size < 3000 || isMicMuted || isProcessing || activePipeline !== 'http') {
            if (!isMicMuted && !isProcessing && activePipeline === 'http') setTimeout(startHTTPRecording, 400)
            return
          }
          isProcessing = true; setStatus('Thinking...')
          const b64 = await blobToBase64(blob)
          try {
            const result = await ipcRenderer.invoke('process-voice-input', b64)
            if (result?.success) {
              addToHistory('user', result.transcript || '')
              addToHistory('asuka', result.reply || '')
              setStatus('"' + (result.reply||'').slice(0,50) + '"')
              if (!isHerMuted && result.base64Audio) await playAudio(result.base64Audio)
            }
          } catch(e) { setStatus('Error: ' + e.message) }
          isProcessing = false
          setStatus('Listening...')
          if (activePipeline === 'http' && !isMicMuted) setTimeout(startHTTPRecording, 600)
        }

        // VAD
        const ctx = new AudioContext()
        const src = ctx.createMediaStreamSource(stream)
        const an  = ctx.createAnalyser(); an.fftSize = 256
        src.connect(an)
        const arr = new Uint8Array(an.frequencyBinCount)
        let speechDetected = false, silenceStart = null
        let noiseFloor = 5, calibSamples = []
        httpMediaRecorder.start(200); httpRecording = true

        const check = () => {
          if (!httpRecording || activePipeline !== 'http') return
          an.getByteFrequencyData(arr)
          const vol = arr.reduce((a,b)=>a+b) / arr.length
          if (calibSamples.length < 10) { calibSamples.push(vol); requestAnimationFrame(check); return }
          if (calibSamples.length === 10) noiseFloor = Math.max(4, (calibSamples.reduce((a,b)=>a+b)/10) * 1.8)
          const threshold = noiseFloor + 3
          if (botIsSpeaking && vol > threshold + 6) stopCurrentAudio()
          if (vol > threshold) { speechDetected = true; silenceStart = null; setStatus('🎤 Hearing you...') }
          else if (speechDetected) {
            if (!silenceStart) silenceStart = Date.now()
            if (Date.now() - silenceStart > 500) {
              httpRecording = false
              try { ctx.close() } catch(e) {}
              if (httpMediaRecorder?.state !== 'inactive') httpMediaRecorder.stop()
              return
            }
          }
          requestAnimationFrame(check)
        }
        check()
        setTimeout(() => {
          if (httpRecording) {
            httpRecording = false
            try { ctx.close() } catch(e) {}
            if (httpMediaRecorder?.state !== 'inactive') httpMediaRecorder.stop()
          }
        }, 10000)
      } catch(e) {
        httpRecording = false
        setStatus('Mic error: ' + e.message)
        setTimeout(startHTTPRecording, 2000)
      }
    }

    // ── Tier 1: Gemini Connection ──────────────────────────────────────────
    async function connectGemini() {
      const apiKey = await ipcRenderer.invoke('get-gemini-key')
      if (!apiKey) { setStatus('No Gemini API key found'); return }

      setStatus('Connecting to Gemini...')

      try {
        geminiWs = new WebSocket(`${GEMINI_WS_URL}?key=${apiKey}`)
        geminiWs.binaryType = 'arraybuffer'

        geminiWs.onopen = async () => {
          console.log('Gemini WS opened — sending setup')
          setStatus('Setting up session...')
          const systemPrompt = await ipcRenderer.invoke('get-system-prompt')
          const toolPrompt = `\n\nCRITICAL TOOL RULES — ALWAYS FOLLOW:
- BTC price, ETH price, ANY crypto price → MUST use get_market_data tool with type="price"
- Fear and greed index → MUST use get_market_data tool with type="feargreed"  
- Funding rate → MUST use get_market_data tool with type="funding"
- Gas fees → MUST use get_market_data tool with type="gas"
- Dominance → MUST use get_market_data tool with type="dominance"
- Add to watchlist, remove from watchlist → MUST use ask_claude tool
- Play YouTube, play music, play song → MUST use ask_claude tool
- Weather, temperature, forecast → MUST use ask_claude tool (returns text, never opens browser)
- Paper trading, my trades, win rate, trading loss, open positions, should I close, take profit → MUST use ask_claude tool
- ANYTHING about the user's specific trades, positions, balance → MUST use ask_claude tool
- Open website, open app → MUST use ask_claude tool ONLY when user explicitly says "open"
- Price alerts, set alert → MUST use ask_claude tool
- Trading journal, log trade → MUST use ask_claude tool
- Portfolio, wallet check → MUST use ask_claude tool
- News, latest news → MUST use ask_claude tool
- Morning briefing → MUST use ask_claude tool
- Contract scan → MUST use ask_claude tool
- NEVER answer market data from memory — ALWAYS use tools
- NEVER answer questions about the user's trades from memory — ALWAYS use ask_claude
- NEVER open a website to answer a question — return text answer only
- NEVER say you can't do something — use ask_claude and it will handle it

VOICE RESPONSE RULES — CRITICAL:
- MAX 1-2 sentences per response for voice
- For prices just say the number: "BTC is at $104,200" — nothing else
- For fear and greed just say: "Fear and greed is 72, greed" — nothing else
- Never give long explanations unless specifically asked
- Never say "as of my last update" or "according to the tool"
- Just give the answer directly and stop`
          const setup = {
            setup: {
              model: 'models/gemini-3.1-flash-live-preview',
              generationConfig: {
                responseModalities: ['audio'],
                speechConfig: {
                  voiceConfig: {
                    prebuiltVoiceConfig: { voiceName: 'Kore' }
                  }
                }
              },
              outputAudioTranscription: {},
              systemInstruction: {
                parts: [{ text: systemPrompt + toolPrompt }]
              },
              tools: [{
                functionDeclarations: [
                  {
                    name: 'ask_claude',
                    description: 'Use for everything except live market data: watchlist, YouTube, music, websites, trading advice, news, portfolio, alerts, journal, contract scan, morning briefing, DCA calc, risk calc',
                    parameters: {
                      type: 'object',
                      properties: {
                        query: { type: 'string', description: 'The full user request word for word' }
                      },
                      required: ['query']
                    }
                  },
                  {
                    name: 'get_market_data',
                    description: 'Get live crypto market data — prices, funding rate, fear and greed, dominance, gas fees',
                    parameters: {
                      type: 'object',
                      properties: {
                        type: { type: 'string', enum: ['price', 'funding', 'feargreed', 'dominance', 'gas'] },
                        coin: { type: 'string', description: 'Coin symbol e.g. BTC ETH SOL' }
                      },
                      required: ['type']
                    }
                  }
                ]
              }]
            }
          }
          geminiWs.send(JSON.stringify(setup))

          // Force start mic after 2 seconds regardless of setupComplete
          setTimeout(() => {
            if (activePipeline === 'gemini' && geminiWs?.readyState === WebSocket.OPEN) {
              geminiReady = true
              sessionActive = true
              geminiRetryCount = 0
              setStatus('Listening...')
              geminiIndEl.style.color = 'rgba(52,211,153,0.8)'
              geminiIndEl.textContent = '● GEMINI LIVE'
              startMicStreaming()
              console.log('Gemini mic started — waiting for voice response')
            }
          }, 2000)
        }

        geminiWs.onmessage = async (event) => {
          let rawData
          if (event.data instanceof Blob) {
            rawData = await event.data.text()
          } else if (event.data instanceof ArrayBuffer) {
            rawData = new TextDecoder().decode(event.data)
          } else {
            rawData = event.data
          }

          try {
            const data = JSON.parse(rawData)
            console.log('Gemini msg keys:', Object.keys(data).join(', '))
            await handleGeminiData(data)
          } catch(e) {
            // Not JSON — skip
          }
        }

        // Gemini audio player — PCM24kHz
        let geminiAudioCtx = null
        let geminiNextTime = 0

        function playGeminiAudio(pcmData) {
          if (isHerMuted) return
          if (!geminiAudioCtx || geminiAudioCtx.state === 'closed') {
            geminiAudioCtx = new AudioContext({ sampleRate: 24000 })
            geminiNextTime = geminiAudioCtx.currentTime
          }
          botIsSpeaking = true
          setStatus('Speaking...')
          const pcm = new Int16Array(pcmData)
          const float32 = new Float32Array(pcm.length)
          for (let i = 0; i < pcm.length; i++) float32[i] = pcm[i] / 32768.0
          const buffer = geminiAudioCtx.createBuffer(1, float32.length, 24000)
          buffer.copyToChannel(float32, 0)
          const source = geminiAudioCtx.createBufferSource()
          source.buffer = buffer
          source.connect(geminiAudioCtx.destination)
          const startTime = Math.max(geminiAudioCtx.currentTime, geminiNextTime)
          source.start(startTime)
          geminiNextTime = startTime + buffer.duration
          source.onended = () => {
            if (geminiNextTime <= geminiAudioCtx.currentTime + 0.05) {
              botIsSpeaking = false
              setStatus('Listening...')
              if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', 0) } catch(e) {}
            }
          }
          if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', 0.7) } catch(e) {}
        }

        let geminiTranscriptBuffer = ''
        let geminiTranscriptTimer = null

        async function handleGeminiData(data) {

          // Session ready
          if (data.setupComplete) {
            geminiReady = true
            sessionActive = true
            geminiRetryCount = 0
            activePipeline = 'gemini'
            setStatus('Listening...')
            geminiIndEl.style.color = 'rgba(52,211,153,0.8)'
            geminiIndEl.textContent = '● GEMINI LIVE'
            log('✅ Gemini Live connected')
            startMicStreaming()
            startNameDetection()
          }

          // Accumulate transcript chunks
          // Accumulate transcript — speak only on turnComplete
          if (data.serverContent?.outputTranscription?.text) {
            geminiTranscriptBuffer += data.serverContent.outputTranscription.text
          }

          if (data.serverContent?.modelTurn?.parts) {
            for (const part of data.serverContent.modelTurn.parts) {
              if (part.text) geminiTranscriptBuffer += part.text
              // Skip Gemini audio — ElevenLabs handles voice
              if (part.inlineData?.mimeType?.includes('audio')) {}
            }
          }

          // Tool call from Gemini
          if (data.toolCall) {
            for (const fc of data.toolCall.functionCalls) {
              await handleToolCall(fc)
            }
          }

          // Turn complete — speak full accumulated response
          if (data.serverContent?.turnComplete) {
            clearTimeout(geminiTranscriptTimer)
            const text = geminiTranscriptBuffer.trim()
            geminiTranscriptBuffer = ''
            if (text && !isHerMuted) {
              log('🎙️ Gemini full reply:', text.slice(0, 80))
              addToHistory('asuka', text)
              setStatus('"' + text.slice(0, 55) + '"')
              botIsSpeaking = true
              await speakText(text)
              botIsSpeaking = false
            }
            if (!isMicMuted) setStatus('Listening...')
            if (geminiWs?.readyState === WebSocket.OPEN) {
              try { geminiWs.send(JSON.stringify({ realtimeInput: { activityStart: {} } })) } catch(e) {}
            }
          }
        }

        geminiWs.onerror = (e) => {
          console.error('Gemini WS error:', e.message || e.type)
          geminiIndEl.style.color = 'rgba(248,113,113,0.6)'
        }

        geminiWs.onclose = (event) => {
          console.log('Gemini closed — code:', event.code, 'reason:', event.reason?.slice(0, 50))
          geminiReady = false
          sessionActive = false
          stopMicStreaming()
          stopNameDetection()
          if (activePipeline !== 'gemini') return

          // Always reconnect Gemini — never fall to HTTP permanently
          const delay = event.code === 1011 ? 5000 : // quota — wait longer
                        event.code === 1008 ? 3000 : // bad request
                        2000                          // normal disconnect
          
          geminiIndEl.style.color = 'rgba(255,255,255,0.3)'
          geminiIndEl.textContent = '● Reconnecting...'
          setStatus('Reconnecting to Gemini...')
          setTimeout(() => { 
            if (activePipeline === 'gemini') connectGemini() 
          }, delay)
        }

      } catch(e) {
        setStatus('Failed to connect: ' + e.message)
        setTimeout(connectGemini, 3000)
      }
    }

    // ── Handle Tool Calls ──────────────────────────────────────────────────
    async function handleToolCall(fc) {
      setStatus('Thinking deeply...')
      log('🔧 Tool call:', fc.name, JSON.stringify(fc.args).slice(0, 80))
      let result = ''

      try {
        if (fc.name === 'ask_claude') {
          result = await ipcRenderer.invoke('claude-query', fc.args.query)
        } else if (fc.name === 'get_market_data') {
          result = await ipcRenderer.invoke('market-data', fc.args.type, fc.args.coin || 'BTC')
        } else if (fc.name === 'scan_contract') {
          result = await ipcRenderer.invoke('scan-contract', fc.args.address, fc.args.chain || 'eth')
        }
      } catch(e) {
        result = 'Could not fetch that right now.'
      }

      // Send tool response back to Gemini
      if (geminiWs && geminiWs.readyState === WebSocket.OPEN) {
        geminiWs.send(JSON.stringify({
          toolResponse: {
            functionResponses: [{
              id: fc.id,
              name: fc.name,
              response: { result }
            }]
          }
        }))
      }
    }

    // ── Name-based interrupt detection ────────────────────────────────────
    let nameRecognition = null

    function startNameDetection() {
      if (!window.webkitSpeechRecognition && !window.SpeechRecognition) return
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition
      nameRecognition = new SR()
      nameRecognition.continuous = true
      nameRecognition.interimResults = true
      nameRecognition.lang = 'en-US'

      nameRecognition.onresult = (e) => {
        if (!botIsSpeaking) return
        const transcript = Array.from(e.results)
          .map(r => r[0].transcript.toLowerCase())
          .join(' ')
        // Interrupt if user says her name or "stop" or "wait"
        if (transcript.includes('asuka') || transcript.includes('stop') || transcript.includes('wait') || transcript.includes('hey')) {
          log('🛑 Interrupt detected:', transcript)
          stopCurrentAudio()
          botIsSpeaking = false
          setStatus('Listening...')
        }
      }

      nameRecognition.onend = () => {
        // Keep restarting while active
        if (geminiReady && !isMicMuted) {
          try { nameRecognition.start() } catch(e) {}
        }
      }

      try { nameRecognition.start() } catch(e) {}
    }

    function stopNameDetection() {
      if (nameRecognition) {
        try { nameRecognition.stop() } catch(e) {}
        nameRecognition = null
      }
    }

    // ── Send text to Gemini ────────────────────────────────────────────────
    function sendTextToGemini(text) {
      if (!geminiWs || geminiWs.readyState !== WebSocket.OPEN) return
      
      // Build parts — include camera frame if active
      const parts = [{ text: text || 'Say a brief friendly greeting.' }]
      
      if (webcamActive) {
        try {
          webcamCanvas.width = 320; webcamCanvas.height = 240
          webcamCanvas.getContext('2d').drawImage(webcamVideo, 0, 0, 320, 240)
          const frame = webcamCanvas.toDataURL('image/jpeg', 0.6).split(',')[1]
          if (frame) {
            parts.unshift({ inlineData: { mimeType: 'image/jpeg', data: frame } })
          }
        } catch(e) {}
      }
      
      geminiWs.send(JSON.stringify({
        clientContent: {
          turns: [{
            role: 'user',
            parts
          }],
          turnComplete: true
        }
      }))
    }

    // ── Microphone streaming to Gemini ────────────────────────────────────
    async function startMicStreaming() {
      if (isMicMuted) return
      // Always clean up before creating new audio context
      try { if (audioProcessor) { audioProcessor.disconnect(); audioProcessor = null } } catch(e) {}
      try { if (audioContext) { audioContext.close(); audioContext = null } } catch(e) {}
      try { if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null } } catch(e) {}
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true, sampleRate: SAMPLE_RATE }
        })

        // Use actual 48kHz (browser default) and downsample to 16kHz
        audioContext = new AudioContext({ sampleRate: 48000 })
        const source = audioContext.createMediaStreamSource(mediaStream)

        await audioContext.audioWorklet.addModule(`data:application/javascript,
          class DownsampleProcessor extends AudioWorkletProcessor {
            process(inputs) {
              const input = inputs[0][0]
              if (!input) return true
              // Downsample 48kHz to 16kHz (factor of 3)
              const downsampled = new Int16Array(Math.floor(input.length / 3))
              for (let i = 0; i < downsampled.length; i++) {
                downsampled[i] = Math.max(-32768, Math.min(32767, input[i * 3] * 32768))
              }
              this.port.postMessage(downsampled.buffer, [downsampled.buffer])
              return true
            }
          }
          registerProcessor('downsample-processor', DownsampleProcessor)
        `)

        const workletNode = new AudioWorkletNode(audioContext, 'downsample-processor')
        workletNode.port.onmessage = (e) => {
          if (!geminiReady || isMicMuted || !geminiWs || geminiWs.readyState !== WebSocket.OPEN) return
          const pcmBuffer = e.data
          const pcm = new Int16Array(pcmBuffer)
          const vol = Array.from(pcm).reduce((s, v) => s + Math.abs(v), 0) / pcm.length / 32768

          // While bot speaking — name detection handles interrupts
          if (botIsSpeaking) return

          const base64Audio = btoa(String.fromCharCode(...new Uint8Array(pcmBuffer)))
          try {
            geminiWs.send(JSON.stringify({
              realtimeInput: {
                audio: { data: base64Audio, mimeType: 'audio/pcm;rate=16000' }
              }
            }))
          } catch(e) {}
        }

        source.connect(workletNode)
        workletNode.connect(audioContext.destination)
        audioProcessor = workletNode
        setStatus('Listening...')

      } catch(e) {
        console.error('Mic error:', e.message)
        setStatus('Mic error — retrying...')
        // Auto retry after 2 seconds
        setTimeout(() => {
          if (activePipeline === 'gemini' && !isMicMuted) {
            console.log('🎤 Retrying mic connection...')
            startMicStreaming()
          }
        }, 2000)
      }
    }

    function stopMicStreaming() {
      try { if (audioProcessor) { audioProcessor.disconnect(); audioProcessor = null } } catch(e) {}
      try { if (audioContext) { audioContext.close(); audioContext = null } } catch(e) {}
      try { if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null } } catch(e) {}
    }

    // ── Camera streaming to Gemini ─────────────────────────────────────────
    let cameraInterval = null

    async function startWebcam() {
      if (webcamActive) return
      try {
        webcamStream = await navigator.mediaDevices.getUserMedia({ video: { width:640, height:480 } })
        webcamVideo.srcObject = webcamStream
        webcamActive = true
        webcamBtn.classList.add('active'); webcamBtn.textContent = '🎥'

        // Monitor stream health — restart if track dies
        webcamStream.getVideoTracks()[0]?.addEventListener('ended', () => {
          console.log('📷 Camera stream ended — restarting...')
          webcamActive = false
          webcamStream = null
          if (cameraInterval) { clearInterval(cameraInterval); cameraInterval = null }
          setTimeout(startWebcam, 1000)
        })

        // Send camera frames to Gemini every 3 seconds
        cameraInterval = setInterval(() => {
          if (!geminiReady || !geminiWs || geminiWs.readyState !== WebSocket.OPEN) return
          try {
            webcamCanvas.width = 320; webcamCanvas.height = 240
            webcamCanvas.getContext('2d').drawImage(webcamVideo, 0, 0, 320, 240)
            const frame = webcamCanvas.toDataURL('image/jpeg', 0.6).split(',')[1]
            geminiWs.send(JSON.stringify({
              realtimeInput: { video: { data: frame, mimeType: 'image/jpeg' } }
            }))
          } catch(e) {}
        }, 3000)

        setStatus('Camera on — I can see you! 👀')
      } catch(e) { 
        console.error('Camera error:', e.message)
        setStatus('Camera error: ' + e.message)
      }
    }

    // Capture frame from webcam for HTTP pipeline
    function captureWebcamFrame() {
      if (!webcamActive || !webcamStream) return null
      try {
        webcamCanvas.width = 640; webcamCanvas.height = 480
        webcamCanvas.getContext('2d').drawImage(webcamVideo, 0, 0, 640, 480)
        return webcamCanvas.toDataURL('image/jpeg', 0.8).split(',')[1]
      } catch(e) { return null }
    }

    function stopWebcam() {
      webcamActive = false
      if (cameraInterval) { clearInterval(cameraInterval); cameraInterval = null }
      if (webcamStream) { webcamStream.getTracks().forEach(t => t.stop()); webcamStream = null }
      webcamBtn.classList.remove('active'); webcamBtn.textContent = '📷'
      setStatus('Listening...')
    }

    webcamBtn.addEventListener('click', () => webcamActive ? stopWebcam() : startWebcam())

    // ── Text input (type to Gemini) ────────────────────────────────────────
    async function sendTypedMessage(text) {
      if (!text?.trim()) return
      stopCurrentAudio()
      addToHistory('user', text)
      setStatus('Thinking...')

      // Check for CA paste
      const caMatch = text.match(/0x[a-fA-F0-9]{40}/)
      if (caMatch) {
        const lower = text.toLowerCase()
        let chain = 'eth'
        if (lower.includes('/bsc/') || lower.includes('bsc')) chain = 'bsc'
        if (lower.includes('/polygon/')) chain = 'polygon'
        if (lower.includes('/arbitrum/')) chain = 'arbitrum'
        if (lower.includes('/base/')) chain = 'base'
        const result = await ipcRenderer.invoke('scan-contract', caMatch[0], chain)
        addToHistory('asuka', result)
        await speakText(result)
        setStatus('Listening...')
        return
      }

      // Always use HTTP for typed text — reliable and fast
      setStatus('Thinking...')
      const cameraFrame = captureWebcamFrame()
      const result = await ipcRenderer.invoke('process-voice-input-text', text, cameraFrame)
      if (result?.success) {
        addToHistory('asuka', result.reply)
        const sentences = splitIntoSentences(result.reply)
        for (const s of sentences) { if (s.trim()) await speakText(s.trim()) }
      } else {
        console.error('HTTP error:', result?.error)
        setStatus('Error — try again')
      }
      setStatus('Listening...')
    }

    // ── Drop files ────────────────────────────────────────────────────────
    document.addEventListener('dragover', e => { e.preventDefault(); dropOverlay.classList.add('active') })
    document.addEventListener('dragleave', () => dropOverlay.classList.remove('active'))
    document.addEventListener('drop', async e => {
      e.preventDefault(); dropOverlay.classList.remove('active')
      const file = e.dataTransfer.files[0]; if (!file) return
      const isImg = file.type.startsWith('image/')
      const isPDF = file.type === 'application/pdf'
      const isJSON= file.name.endsWith('.json')

      if (isJSON) {
        const text = await file.text()
        const r = await ipcRenderer.invoke('restore-backup', text)
        await speakText(r); return
      }
      if (!isImg && !isPDF) return

      setStatus(isPDF ? 'Analyzing document...' : 'Analyzing image...')
      const reader = new FileReader()
      reader.onloadend = async () => {
        const b64 = reader.result.split(',')[1]
        const prompt = isPDF
          ? 'Analyze this. Red flags, tokenomics, verdict — legit or scam? 2-3 sentences.'
          : 'What is this exactly? Brand, model, version. 1-2 sentences.'
        const r = await ipcRenderer.invoke('look-at-image', b64, file.type, prompt)
        if (r?.success) { addToHistory('asuka', r.reply); await speakText(r.reply) }
        setStatus('Listening...')
      }
      reader.readAsDataURL(file)
    })


    // ── Care system ───────────────────────────────────────────────────────
    const careBtn = document.getElementById('care-btn')
    function statBar(label, val, color) {
      const v = Math.round(val)
      return `<div><div style="display:flex;justify-content:space-between;"><span>${label}</span><span>${v}%</span></div><div style="height:7px;background:#1e293b;border-radius:5px;overflow:hidden;"><div style="height:100%;width:${v}%;background:${color};border-radius:5px;transition:.3s;"></div></div></div>`
    }
    function renderCare(d) {
      document.getElementById('care-coins').textContent = d.coins ?? 0
      document.getElementById('care-streak').textContent = d.streak ?? 0
      document.getElementById('care-stats').innerHTML =
        statBar('🍰 Hunger', d.hunger, '#fbbf24') +
        statBar('😊 Happiness', d.happiness, '#34d399') +
        statBar('✨ Cleanliness', d.cleanliness, '#60a5fa') +
        statBar('💕 Affection', d.affection, '#f472b6')
    }

    async function refreshRelationship() {
      const r = await ipcRenderer.invoke('get-relationship').catch(()=>null)
      if (!r) return
      document.getElementById('rel-tier').textContent = r.tier.emoji + ' ' + r.tier.name
      document.getElementById('rel-next').textContent = r.next ? `${r.toNext} XP → ${r.next.name}` : 'MAX 👑'
      document.getElementById('rel-fill').style.width = r.progress + '%'
    }
    ipcRenderer.on('relationship-levelup', (e, info) => {
      const pop = document.getElementById('levelup-pop')
      document.getElementById('lu-emoji').textContent = info.tier.emoji
      document.getElementById('lu-tier').textContent = info.tier.name
      const names = (info.unlocked||[]).map(u=>u.split(':')[1]).join(', ')
      document.getElementById('lu-unlock').textContent = names ? '🎁 Unlocked: ' + names + ` · +${info.coinBonus} 🪙` : `+${info.coinBonus} 🪙`
      pop.style.display = 'flex'
      setTimeout(()=>{ pop.style.display='none' }, 3500)
      refreshRelationship()
    })

    async function refreshCare() { const d = await ipcRenderer.invoke('get-care').catch(()=>null); if (d) renderCare(d) }
    careBtn?.addEventListener('click', () => {
      const p = document.getElementById('care-panel')
      const show = p.style.display === 'none'
      p.style.display = show ? 'block' : 'none'
      if (show) { refreshCare(); refreshRelationship() }
    })
    document.getElementById('care-close')?.addEventListener('click', () => document.getElementById('care-panel').style.display='none')
    document.querySelectorAll('.care-act').forEach(b => b.addEventListener('click', async () => {
      const r = await ipcRenderer.invoke('care-action', b.dataset.a).catch(()=>null)
      if (r?.success) { renderCare(r.state); refreshRelationship() }
    }))
    document.getElementById('shop-open-btn')?.addEventListener('click', () => ipcRenderer.send('open-shop'))
    ipcRenderer.on('care-updated', (e, d) => renderCare(d))
    // include care-btn in no-drag
    setTimeout(()=>{refreshCare();refreshRelationship()}, 1500)


    // ══ REACTION SYSTEM — she reacts to live events (Comnyang-inspired) ══════
    // Tries Live2D expression params (common names), always shows an emotion bubble fallback.
    let _emotionTimer = null
    function setEmotion(emotion) {
      if (!model) return
      // Try common Live2D expression parameters (safe — wrapped, no-op if model lacks them)
      const cm = model.internalModel?.coreModel
      if (!cm) return
      const tryParam = (id, val) => { try { cm.setParameterValueById(id, val) } catch(e){} }
      // Reset common expression params
      tryParam('ParamBrowLY', 0); tryParam('ParamBrowRY', 0)
      tryParam('ParamMouthForm', 0); tryParam('ParamEyeLOpen', 1); tryParam('ParamEyeROpen', 1)
      if (emotion === 'happy') { tryParam('ParamMouthForm', 1); tryParam('ParamBrowLY', 0.5); tryParam('ParamBrowRY', 0.5) }
      else if (emotion === 'excited') { tryParam('ParamMouthForm', 1); tryParam('ParamMouthOpenY', 0.6); tryParam('ParamEyeLOpen', 1.2); tryParam('ParamEyeROpen', 1.2) }
      else if (emotion === 'worried') { tryParam('ParamMouthForm', -0.8); tryParam('ParamBrowLY', -0.6); tryParam('ParamBrowRY', -0.6) }
      else if (emotion === 'sad') { tryParam('ParamMouthForm', -1); tryParam('ParamBrowLY', -0.8); tryParam('ParamBrowRY', -0.8); tryParam('ParamEyeLOpen', 0.6); tryParam('ParamEyeROpen', 0.6) }
      else if (emotion === 'thinking') { tryParam('ParamEyeBallX', 0.5); tryParam('ParamEyeBallY', 0.5); tryParam('ParamBrowLY', -0.3); tryParam('ParamBrowRY', -0.3) }
      else if (emotion === 'love') { tryParam('ParamMouthForm', 1); tryParam('ParamEyeLOpen', 0.7); tryParam('ParamEyeROpen', 0.7) }
      // try a named expression too (some models have these)
      try { model.expression?.(emotion) } catch(e) {}
    }
    // Visual emotion bubble (works for ANY model — the reliable feedback)
    function showEmotionBubble(emoji, text, color) {
      let b = document.getElementById('emotion-bubble')
      if (!b) {
        b = document.createElement('div'); b.id = 'emotion-bubble'
        b.style.cssText = 'position:fixed;top:14px;left:50%;transform:translateX(-50%) translateY(-10px);z-index:10002;background:linear-gradient(135deg,rgba(22,27,46,.97),rgba(15,19,32,.97));border:1px solid rgba(167,139,250,.4);border-radius:16px;padding:9px 15px;font-family:Outfit,system-ui;font-size:12px;color:#f4f5fb;box-shadow:0 8px 28px rgba(0,0,0,.5);opacity:0;transition:.3s;display:flex;align-items:center;gap:7px;max-width:260px;'
        document.body.appendChild(b)
      }
      b.style.borderColor = color || 'rgba(167,139,250,.4)'
      b.innerHTML = `<span style="font-size:18px;">${emoji}</span><span>${text}</span>`
      requestAnimationFrame(() => { b.style.opacity = '1'; b.style.transform = 'translateX(-50%) translateY(0)' })
      clearTimeout(b._t); b._t = setTimeout(() => { b.style.opacity = '0'; b.style.transform = 'translateX(-50%) translateY(-10px)' }, 4000)
    }
    // The master reaction trigger
    function react(emotion, emoji, text, color, speakIt) {
      setEmotion(emotion)
      if (emoji) showEmotionBubble(emoji, text || '', color)
      if (model) try { model.motion?.(emotion === 'excited' || emotion === 'happy' ? 'tap_body' : 'idle') } catch(e){}
      clearTimeout(_emotionTimer)
      _emotionTimer = setTimeout(() => setEmotion('neutral'), 6000)
      if (speakIt && text && !isHerMuted) ipcRenderer.invoke('speak-text', text).catch(()=>{})
    }

    // ── Event reactions from the backend ──────────────────────────────────
    ipcRenderer.on('asuka-react', (e, ev) => {
      const R = {
        swarm_thinking: ['thinking', '🤔', 'Let me think on this trade...', 'rgba(45,212,255,.4)', false],
        swarm_strong:   ['excited', '🐟', `The agents strongly agree!`, 'rgba(52,211,153,.4)', false],
        swarm_split:    ['worried', '😟', `The agents are split — being careful`, 'rgba(251,191,36,.4)', false],
        trade_win:      ['excited', '🎉', `We hit target! Nice trade!`, 'rgba(52,211,153,.4)', true],
        trade_loss:     ['sad', '😔', `That one stopped out. We'll get the next.`, 'rgba(251,113,133,.4)', true],
        trade_open:     ['happy', '💼', `Opened a ${ev.detail||'trade'}!`, 'rgba(167,139,250,.4)', false],
        trade_skip:     ['thinking', '🛑', `Skipped that one — didn't meet the bar`, 'rgba(107,114,146,.4)', false],
        rule_block:     ['worried', '📋', `Skipped — your rule said no`, 'rgba(251,191,36,.4)', false],
        lesson_done:    ['happy', '🌸', `Great lesson! You're improving!`, 'rgba(243,168,208,.4)', false],
        levelup:        ['love', '💖', ev.detail || `We grew closer!`, 'rgba(243,168,208,.5)', false],
        care:           ['love', '💕', ev.detail || `Thank you!`, 'rgba(243,168,208,.4)', false]
      }
      const r = R[ev.type]
      if (r) react(r[0], r[1], ev.text || r[2], r[3], r[4])
    })

    // ── PEEK MODE — shrink/fade when user is in fullscreen or idle-busy ──────
    let _peeked = false
    function setPeek(on) {
      if (on === _peeked) return; _peeked = on
      const canvas = document.getElementById('canvas') || document.querySelector('canvas')
      if (canvas) { canvas.style.transition = 'opacity .5s, transform .5s'; canvas.style.opacity = on ? '0.35' : '1'; canvas.style.transform = on ? 'scale(0.75)' : 'scale(1)' }
    }
    ipcRenderer.on('set-peek', (e, on) => setPeek(on))

    // ── Voice chunk QUEUE — plays streamed sentences in order (no interrupting) ──
    let _voiceQueue = [], _voicePlaying = false
    async function _drainVoiceQueue() {
      if (_voicePlaying) return
      _voicePlaying = true
      while (_voiceQueue.length) {
        const chunk = _voiceQueue.shift()
        if (chunk.text) { setStatus('"' + chunk.text.slice(0,55) + '"'); addToHistory('asuka', chunk.text) }
        try { await playAudioQueued(chunk.audio) } catch(e) {}
      }
      _voicePlaying = false
      setStatus('Listening...')
    }
    // Like playAudio but does NOT stop the previous (we already wait for each to finish)
    async function playAudioQueued(b64) {
      if (!b64 || isHerMuted) return
      try {
        const bytes = new Uint8Array(atob(b64).split('').map(c => c.charCodeAt(0)))
        const blob  = new Blob([bytes], { type:'audio/mpeg' })
        const ctx   = new AudioContext()
        const buf   = await ctx.decodeAudioData(await blob.arrayBuffer())
        const src   = ctx.createBufferSource()
        const an    = ctx.createAnalyser(); an.fftSize = 256
        src.buffer = buf; src.connect(an); an.connect(ctx.destination)
        currentSource = src; botIsSpeaking = true
        src.start()
        const arr = new Uint8Array(an.frequencyBinCount)
        const tick = () => { if (!botIsSpeaking) return; an.getByteFrequencyData(arr); const v = arr.reduce((a,b)=>a+b)/arr.length; if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', Math.min(v/80,1)) } catch(e){}; requestAnimationFrame(tick) }
        tick()
        await new Promise(r => { src.onended = () => { if (model) try { model.internalModel.coreModel.setParameterValueById('ParamMouthOpenY', 0) } catch(e){}; r() } })
      } catch(e) {}
    }
    ipcRenderer.on('voice-chunk', (e, chunk) => {
      if (isHerMuted) return
      if (chunk.isFirst) { _voiceQueue = [] } // new utterance — clear stale
      _voiceQueue.push(chunk)
      _drainVoiceQueue()
    })

    // ── IPC Events ────────────────────────────────────────────────────────
    ipcRenderer.on('play-audio', async (e, { audio, text }) => {
      if (text) { setStatus('"' + text.slice(0,55) + '"'); addToHistory('asuka', text) }
      await playAudio(audio)
      setStatus('Listening...')
    })
    ipcRenderer.on('price-alert', async (e, { msg, audio }) => {
      if (isHerMuted) return
      setStatus('🔔 ' + msg.slice(0,50)); addToHistory('asuka', msg); await playAudio(audio)
    })
    ipcRenderer.on('stop-webcam',    () => stopWebcam())
    ipcRenderer.on('stop-recording', () => { isMicMuted = true; stopMicStreaming() })
    let lastStartRecording = 0
    ipcRenderer.on('start-recording', () => { 
      const now = Date.now()
      if (now - lastStartRecording < 3000) return // Debounce 3 seconds
      lastStartRecording = now
      isMicMuted = false
      startMicStreaming()
    })
    ipcRenderer.on('ask-morning-briefing', () => showConfirm('morning', 'Want your morning market briefing?'))
    ipcRenderer.on('ask-news-briefing',    () => showConfirm('news', 'Want the latest crypto news?'))

    // ── Confirm bar ───────────────────────────────────────────────────────
    function showConfirm(type, text) { awaitingConfirm = type; confirmText.textContent = text; confirmBar.classList.add('open') }
    function hideConfirm() { awaitingConfirm = null; confirmBar.classList.remove('open') }

    confirmYes.addEventListener('click', async () => {
      const type = awaitingConfirm; hideConfirm()
      const r = type === 'morning'
        ? await ipcRenderer.invoke('confirm-morning-briefing')
        : await ipcRenderer.invoke('confirm-news-briefing')
      if (r?.reply) { addToHistory('asuka', r.reply); await speakText(r.reply) }
    })
    confirmNo.addEventListener('click', hideConfirm)

    // ── Buttons ───────────────────────────────────────────────────────────
    herMuteBtn.addEventListener('click', () => {
      isHerMuted = !isHerMuted
      herMuteBtn.textContent = isHerMuted ? '🔇' : '🔊'
      isHerMuted ? herMuteBtn.classList.add('muted') : herMuteBtn.classList.remove('muted')
      if (isHerMuted) stopCurrentAudio()
    })

    micMuteBtn.addEventListener('click', () => {
      isMicMuted = !isMicMuted
      micMuteBtn.textContent = isMicMuted ? '🚫' : '🎤'
      isMicMuted ? micMuteBtn.classList.add('muted') : micMuteBtn.classList.remove('muted')
      if (isMicMuted) stopMicStreaming()
      else startMicStreaming()
    })

    chatBtn.addEventListener('click', () => chatPanel.classList.toggle('open'))
    dashBtn.addEventListener('click', () => ipcRenderer.send('open-dashboard'))

    sendBtn.addEventListener('click', async () => {
      const msg = userInput.value.trim(); if (!msg) return
      userInput.value = ''; chatPanel.classList.remove('open')
      await sendTypedMessage(msg)
    })
    userInput.addEventListener('keydown', e => { if (e.key === 'Enter') sendBtn.click() })

    // Save session and extract learnings when window closes
    window.addEventListener('beforeunload', async () => {
      const allHistory = chatHistory.slice(-30).map(m => ({ role: m.role === 'user' ? 'user' : 'assistant', content: m.text }))
      if (allHistory.length > 2) {
        ipcRenderer.invoke('end-conversation', allHistory)
      }
    })

    // ── Start ──────────────────────────────────────────────────────────────
    window.addEventListener('DOMContentLoaded', () => {
      switchToPipeline('gemini')
    })
  </script>
</body>
</html>
